# ============================================================
# OMC 运行时状态(per-project 操作产物,不入版本控制)
# .omc/skills/ 例外,可作为项目级技能提交
# 注意: 用 **/ 前缀以覆盖 backend/ frontend/ 等嵌套位置
# ============================================================
**/.omc/*
!**/.omc/skills/

# ============================================================
# AI 工具本地安装产物(不入版本控制)
# .agents / .claude / skills-lock.json 由 skills CLI 生成,只在本机生效
# .mcp.json 是本机 MCP 服务地址(指向 localhost),各机器不同,不入库
# ============================================================
.agents/
.claude/
skills-lock.json
.mcp.json

# ============================================================
# 项目文档(handoff / 过程记录,仅本机留存)
# ============================================================
docs/

# ============================================================
# 环境变量与密钥
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ============================================================
# Go 后端 (backend/)
# ============================================================
# 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试二进制与覆盖率文件
*.test
*.out
coverage.out
coverage.html
profile.out

# 构建输出目录
bin/
dist/

# 运行时产物:日志(含 logrotate 轮转出来的 .log.1 / .log.gz)
# 目录整体忽略,比只靠上面的 *.log 更稳妥
logs/
*.log.*

# 运行时产物:头像 / 视频 / 封面 / 分片临时目录,统一在 backend/storage/ 下。
# 只提交目录结构(.gitkeep),上传的文件一律不入库
# 后两条是必需的:父目录被排除后,里面的文件无法再被单独 re-include
backend/storage/**
!backend/storage/**/
!backend/storage/**/.gitkeep

# Go workspace(未使用 workspace 特性时启用)
# go.work.sum

# 依赖目录(仅在使用 go mod vendor 时启用)
# vendor/

# ============================================================
# React / TypeScript 前端 (frontend/)
# ============================================================
node_modules/
.pnp
.pnp.js

# 构建输出
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.svelte-kit/
.vite/

# 缓存
.cache/
.parcel-cache/
.turbo/
.tsbuildinfo
*.tsbuildinfo

# 测试与覆盖率
coverage/
.nyc_output/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 杂项
.DS_Store
Thumbs.db

# ============================================================
# IDE / 编辑器
# ============================================================
# .vscode 整个目录忽略:extensions.json 里是个人装的插件,不是团队共享的推荐列表。
# 只留 settings.json.example 作为可提交的示例配置
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
.codebuddy/

# ============================================================
# 操作系统
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
desktop.ini
